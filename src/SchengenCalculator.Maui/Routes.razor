<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="@extraAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
    </Found>
    <NotFound>
        <p>Page not found.</p>
    </NotFound>
</Router>

@code {
    // Include the web app assembly so MAUI can discover its @page routes
    private static readonly Assembly[] extraAssemblies =
    [
        typeof(SchengenCalculator.Pages.Home).Assembly
    ];
}
