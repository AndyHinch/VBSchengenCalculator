<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>SchengenCalculator.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App information -->
    <ApplicationTitle>Schengen Calculator</ApplicationTitle>
    <ApplicationId>com.andrewhinchcliffe.schengencalculator</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    
    <!-- Resolve static web asset conflicts -->
    <ResolveStaticWebAssetsInputsDependsOn>
      RemoveConflictingStaticWebAssets;
      $(ResolveStaticWebAssetsInputsDependsOn)
    </ResolveStaticWebAssetsInputsDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MauiAsset for splash, fonts, icons -->
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#1a365d" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#1a365d" BaseSize="128,128" />
    <MauiFont Include="Resources/Fonts/*" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.0" />
    <PackageReference Include="MudBlazor" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse all shared Razor components from the web project -->
    <ProjectReference Include="..\..\blazor-app\SchengenCalculator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <Target Name="RemoveConflictingStaticWebAssets" BeforeTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <!-- Remove index.html from referenced project's static web assets -->
      <StaticWebAsset Remove="@(StaticWebAsset)" Condition="'%(SourceId)' == 'SchengenCalculator' AND '%(RelativePath)' == 'index.html'" />
    </ItemGroup>
  </Target>

</Project>
