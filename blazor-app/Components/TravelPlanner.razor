<div class="card">
    <div class="card-body">
        <h5 class="card-title">Travel Planner</h5>

        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false">

            @* ── Tab 1: Can I travel? ── *@
            <MudTabPanel Text="Can I travel?">
                <p class="text-muted small mb-3">
                    Enter the dates of a trip you are planning and see if it would breach the 90-day limit.
                </p>

                <MudDateRangePicker Label="Proposed trip dates"
                                    DateRange="proposedRange"
                                    DateRangeChanged="HandleRangeChanged"
                                    PickerVariant="PickerVariant.Inline"
                                    AutoClose="true"
                                    DateFormat="dd/MM/yyyy"
                                    Class="mb-2" />

                @if (proposedRange?.Start != null && proposedRange?.End != null)
                {
                    var days = (int)(proposedRange.End.Value - proposedRange.Start.Value).TotalDays + 1;
                    <p class="text-muted small mb-2">Trip length: <strong>@days day@(days == 1 ? "" : "s")</strong></p>
                }

                <button class="btn btn-primary" @onclick="CheckTrip"
                        disabled="@(proposedRange?.Start == null || proposedRange?.End == null)">
                    Check Trip
                </button>

                @if (checkResult != null)
                {
                    <div class="mt-3">
                        @if (checkResult.IsSafe && !checkResult.IsTight)
                        {
                            <div class="alert alert-success py-2">
                                <strong>✅ Safe to travel!</strong><br />
                                This trip would use <strong>@checkResult.MaxDaysUsed days</strong> at its peak,
                                leaving <strong>@checkResult.DaysRemainingAfter days</strong> of your allowance.
                            </div>
                        }
                        else if (checkResult.IsTight)
                        {
                            <div class="alert alert-warning py-2">
                                <strong>⚠️ Safe, but tight!</strong><br />
                                This trip is within the limit, but you would only have
                                <strong>@checkResult.DaysRemainingAfter day@(checkResult.DaysRemainingAfter == 1 ? "" : "s")</strong> remaining afterwards.
                                Peak usage: <strong>@checkResult.MaxDaysUsed / 90 days</strong>.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger py-2">
                                <strong>❌ This trip would exceed your limit.</strong><br />
                                You would breach the 90-day limit on
                                <strong>@checkResult.BreachDate!.Value.ToString("d MMM yyyy")</strong>,
                                reaching a peak of <strong>@checkResult.MaxDaysUsed days</strong>
                                (@(Math.Abs(checkResult.DaysRemainingAfter)) over the limit).
                            </div>
                        }
                    </div>
                }
            </MudTabPanel>

            @* ── Tab 2: Earliest safe date ── *@
            <MudTabPanel Text="Earliest safe date">
                <p class="text-muted small mb-3">
                    Enter how many days you want to travel and find the earliest date you could safely start.
                </p>

                <div class="d-flex align-items-end gap-3 flex-wrap mb-3">
                    <div>
                        <label class="form-label mb-1">Trip length (days)</label>
                        <input type="number" class="form-control" style="width:120px;"
                               min="1" max="90" @bind="desiredDays" />
                    </div>
                    <div>
                        <label class="form-label mb-1">Search from</label>
                        <input type="date" class="form-control" style="width:175px;"
                               @bind="searchFrom" />
                    </div>
                    <button class="btn btn-primary mb-0" @onclick="FindEarliestDate" disabled="@isSearching">
                        @if (isSearching)
                        {
                            <span class="spinner-border spinner-border-sm me-1" />
                            <span>Searching…</span>
                        }
                        else
                        {
                            <span>Find Earliest Date</span>
                        }
                    </button>
                </div>

                @if (earliestResult.HasValue)
                {
                    var endDate = earliestResult.Value.AddDays(desiredDays - 1);
                    var r = new SchengenCalc(Trips).CheckProposedTrip(earliestResult.Value, endDate);
                    <div class="alert alert-success py-2">
                        <strong>✅ Earliest safe start: @earliestResult.Value.ToString("d MMM yyyy")</strong><br />
                        A @desiredDays-day trip from @earliestResult.Value.ToString("d MMM") to @endDate.ToString("d MMM yyyy")
                        would use a peak of <strong>@r.MaxDaysUsed days</strong>,
                        leaving <strong>@r.DaysRemainingAfter days</strong> remaining.
                    </div>
                }
                else if (earliestSearchDone && !earliestResult.HasValue)
                {
                    <div class="alert alert-warning py-2">
                        <strong>⚠️ No safe window found</strong> in the next 2 years for a @desiredDays-day trip.
                    </div>
                }
            </MudTabPanel>

        </MudTabs>
    </div>
</div>

@code {
    [Parameter] public List<TripDate> Trips { get; set; } = [];

    // Tab 1 — Can I travel?
    private DateRange? proposedRange;
    private TravelCheckResult? checkResult;

    // Tab 2 — Earliest safe date
    private int desiredDays = 14;
    private DateTime searchFrom = DateTime.Today;
    private DateTime? earliestResult;
    private bool earliestSearchDone;
    private bool isSearching;

    private void HandleRangeChanged(DateRange range)
    {
        proposedRange = range;
        checkResult = null;
    }

    private void CheckTrip()
    {
        if (proposedRange?.Start == null || proposedRange?.End == null) return;
        var calc = new SchengenCalc(Trips);
        checkResult = calc.CheckProposedTrip(
            proposedRange.Start.Value.Date,
            proposedRange.End.Value.Date);
    }

    private async Task FindEarliestDate()
    {
        isSearching = true;
        earliestSearchDone = false;
        earliestResult = null;
        StateHasChanged();
        await Task.Delay(50); // allow spinner to render before heavy computation

        var calc = new SchengenCalc(Trips);
        earliestResult = calc.EarliestSafeTripStart(desiredDays, searchFrom);
        earliestSearchDone = true;
        isSearching = false;
    }
}
