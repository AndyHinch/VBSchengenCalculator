<div class="card">
    <div class="card-body">
        <h5 class="card-title">Calculate Days</h5>

        <div class="d-flex align-items-end gap-3 flex-wrap">
            <div style="min-width: 200px;">
                <MudDatePicker Label="Review Date"
                               Date="reviewDate"
                               DateChanged="HandleDateChanged"
                               DateFormat="dd/MM/yyyy"
                               Editable="true" />
            </div>
        </div>

        <div class="preset-row mt-2">
            <span class="preset-label">Jump to:</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => HandleDateChanged(DateTime.Today)'>Today</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => HandleDateChanged(DateTime.Today.AddDays(30))'>+30 days</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => HandleDateChanged(DateTime.Today.AddDays(60))'>+60 days</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => HandleDateChanged(DateTime.Today.AddDays(90))'>+90 days</button>
        </div>

        @if (result is not null)
        {
            var pct = Math.Min((double)usedDays / 90 * 100, 100);
            var barColour = usedDays <= 60 ? "bg-success" : usedDays <= 80 ? "bg-warning" : "bg-danger";

            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small fw-semibold">@usedDays / 90 days used</span>
                    <span class="small text-muted">@reviewDate?.ToString("d MMM yyyy")</span>
                </div>
                <div class="progress" style="height: 18px; border-radius: 9px;">
                    <div class="progress-bar @barColour"
                         role="progressbar"
                         style="width: @pct.ToString("F1")%; border-radius: 9px;"
                         aria-valuenow="@usedDays" aria-valuemin="0" aria-valuemax="90">
                    </div>
                </div>
                <div class="alert @(isOver ? "alert-danger" : "alert-success") mt-2 mb-0 py-2">
                    @result
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<TripDate> Trips { get; set; } = [];

    private DateTime? reviewDate = DateTime.Today;
    private string? result;
    private bool isOver;
    private int usedDays;

    // Auto-calculate whenever the date changes
    private void HandleDateChanged(DateTime? date)
    {
        reviewDate = date;
        if (date is null) { result = null; return; }

        var calc = new SchengenCalc(Trips);
        usedDays = calc.NumberOfDaysInAreaOnDay(date.Value);
        int remaining = 90 - usedDays;
        isOver = remaining < 0;
        result = isOver
            ? $"{usedDays} used, {Math.Abs(remaining)} over!"
            : $"{usedDays} used, {remaining} remaining";
    }

    // Re-run when trips change
    protected override void OnParametersSet() => HandleDateChanged(reviewDate);
}
