<div class="modal-backdrop">
    <div class="modal-box trip-form-box">
        <h2>@(isEdit ? "Edit Trip" : "Add Trip")</h2>

        <MudDateRangePicker Label="Select trip dates"
                            DateRange="dateRange"
                            DateRangeChanged="HandleRangeChanged"
                            PickerVariant="PickerVariant.Inline"
                            AutoClose="true"
                            DateFormat="dd/MM/yyyy"
                            Class="mb-3" />

        <div class="quick-label">Quick end date from start:</div>
        <div class="quick-buttons">
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetDuration(7)">1 week</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetDuration(14)">2 weeks</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetDuration(21)">3 weeks</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetDuration(30)">30 days</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetDuration(60)">60 days</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => SetDuration(90)">90 days</button>
        </div>

        @if (dateRange?.Start != null && dateRange?.End != null)
        {
            var days = (int)(dateRange.End.Value - dateRange.Start.Value).TotalDays + 1;
            <div class="duration-badge mt-2">
                @dateRange.Start.Value.ToString("d MMM yyyy") – @dateRange.End.Value.ToString("d MMM yyyy")
                &nbsp;·&nbsp; <strong>@days day@(days == 1 ? "" : "s")</strong>
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="text-danger mt-2 mb-0">@error</p>
        }

        <div class="modal-actions mt-3">
            <button class="btn btn-primary" @onclick="HandleSave">Save</button>
            <button class="btn btn-secondary ms-2" @onclick="OnCancel">Cancel</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public DateTime InitialStart { get; set; }
    [Parameter] public DateTime InitialEnd { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public EventCallback<(DateTime Start, DateTime End)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private DateRange? dateRange;
    private string error = "";
    private bool isEdit;

    protected override void OnParametersSet()
    {
        dateRange = new DateRange(InitialStart, InitialEnd);
        isEdit = IsEdit;
        error = "";
    }

    private void HandleRangeChanged(DateRange range)
    {
        dateRange = range;
        error = "";
    }

    private void SetDuration(int days)
    {
        var start = dateRange?.Start ?? DateTime.Today;
        dateRange = new DateRange(start, start.AddDays(days - 1));
    }

    private async Task HandleSave()
    {
        if (dateRange?.Start == null || dateRange?.End == null)
        {
            error = "Please select both a start and end date.";
            return;
        }
        if (dateRange.Start.Value.Date >= dateRange.End.Value.Date)
        {
            error = "Start date must be before end date.";
            return;
        }
        await OnSave.InvokeAsync((dateRange.Start.Value.Date, dateRange.End.Value.Date));
    }
}
